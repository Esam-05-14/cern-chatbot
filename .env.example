# CERN GitLab MCP Server Configuration
# Copy this file to .env and adjust as needed.

# GitLab instance URL (default: https://gitlab.cern.ch)
# CERNGITLAB_GITLAB_URL=https://gitlab.cern.ch

# Personal access token (optional — public repos work without it)
# Create at: https://gitlab.cern.ch/-/user_settings/personal_access_tokens
# Required scope: read_api
# CERNGITLAB_TOKEN=glpat-xxxxxxxxxxxx

# HTTP timeout in seconds (default: 30)
# CERNGITLAB_TIMEOUT=30

# Max retries for failed requests (default: 3)
# CERNGITLAB_MAX_RETRIES=3

# API rate limit per minute (default: 300)
# CERNGITLAB_RATE_LIMIT_PER_MINUTE=300

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# CERNGITLAB_LOG_LEVEL=INFO

# --- Optional cerngitlab-chat ---
# Prefer the full venv on Windows (avoids locked .venv + fewer AV prompts):
#   .\.venv-full\Scripts\Activate.ps1
#   uv sync --group chat --group rag --active
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Prefer a tool-calling chat model. Do NOT use openrouter/free (unstable routing +
# daily free-tier caps break MCP tool calling and evals).
# OpenAI:
# CERNGITLAB_CHAT_MODEL=gpt-4.1-mini
# OpenRouter (pin a concrete model id):
# CERNGITLAB_CHAT_MODEL=openai/gpt-4.1-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CERNGITLAB_CHAT_EMBED_MODEL=text-embedding-3-small
# CERNGITLAB_CHAT_MCP_RETRIES=1
# Pin MCP child to .venv-full (recommended on Windows):
# CERNGITLAB_CHAT_MCP_COMMAND=E:\LHCB\cerngitlab-mcp\.venv-full\Scripts\cerngitlab-mcp.exe
# Enable after: cerngitlab-chat-index --clone
# CERNGITLAB_CHAT_RAG=1
# CERNGITLAB_CHAT_RAG_INDEX_DIR=.cache/cerngitlab-chat/faiss
